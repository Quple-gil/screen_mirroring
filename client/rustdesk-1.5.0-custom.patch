+// fork: one-click connection info. The controlled side copies ID, password and a
+// rustdesk:// link as one text; pasting that text into the remote ID box connects directly.
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/common/formatter/id_formatter.dart';
+
+final _inviteLink = RegExp(r'rustdesk://([0-9A-Za-z_\-]+)(?:\?password=([^\s&]+))?');
+
+class ConnectInvite {
+  final String id;
+  final String? password;
+  ConnectInvite(this.id, this.password);
+}
+
+void copyConnectInvite(String id, String? password) {
+  id = trimID(id);
+  if (id.isEmpty) return;
+  final hasPassword = password != null && password.isNotEmpty;
+  final link = hasPassword
+      ? 'rustdesk://$id?password=${Uri.encodeQueryComponent(password)}'
+      : 'rustdesk://$id';
+  // The link stays on the last line: a single-line text field drops the line
+  // breaks when this is pasted, and the parser needs the password to end the text.
+  final text = [
+    '${translate("ID")}: ${formatID(id)}',
+    if (hasPassword) '${translate("One-time Password")}: $password',
+    translate(
+        'Click the link to connect (RustDesk must be installed), or paste this whole text into the remote ID box'),
+    link,
+  ].join('\n');
+  Clipboard.setData(ClipboardData(text: text));
+  showToast(translate('Copied'));
+}
+
+ConnectInvite? parseConnectInvite(String text) {
+  final m = _inviteLink.firstMatch(text);
+  if (m == null) return null;
+  final password = m.group(2);
+  return ConnectInvite(m.group(1)!,
+      password == null ? null : Uri.decodeQueryComponent(password));
+}
