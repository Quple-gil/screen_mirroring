+/// Downscales a 32-bit capture (BGRA / RGBA) into `dst` so it can be encoded at a lower
+/// stream resolution without touching the real display mode.
+#[cfg(not(target_os = "ios"))]
+pub fn scale_32bit(
+    captured: &PixelBuffer,
+    dst_w: usize,
+    dst_h: usize,
+    dst: &mut Vec<u8>,
+) -> ResultType<()> {
+    if captured.pixfmt().bytes_per_pixel() != 4 {
+        bail!("cannot scale pixfmt {:?}", captured.pixfmt());
+    }
+    let dst_stride = dst_w * 4;
+    dst.resize(dst_stride * dst_h, 0);
+    call_yuv!(ARGBScale(
+        captured.data().as_ptr(),
+        captured.stride()[0] as _,
+        captured.width() as _,
+        captured.height() as _,
+        dst.as_mut_ptr(),
+        dst_stride as _,
+        dst_w as _,
+        dst_h as _,
+        FilterMode::kFilterBox,
+    ));
+    Ok(())
+}
