# 【暂未启用】域名 ICP 备案下来后再用：给后台换成 Let's Encrypt 正式证书。
# 启用步骤见 README“备案后启用域名”。2026-10-21 已验证可用 tls-alpn-01（只需 443 端口）签发证书。

{
	# 直接用 IP 访问时浏览器不带 SNI，没有这一行 Caddy 不知道用哪张证书，握手会失败
	default_sni {$PUBLIC_IP}
}

# 后台的 HTTPS 入口。证书由 Caddy 自动向 Let's Encrypt 申请和续期（443 端口完成验证，80 端口可不开）
{$DOMAIN} {
	# 和默认值一样；写出来是为了让 Caddy 生成连接策略，上面的 default_sni 才会生效
	tls {
		protocols tls1.2 tls1.3
	}
	encode gzip
	reverse_proxy 127.0.0.1:8000
}

# 备用入口：域名万一被拦截时用 IP 访问（Caddy 自签名证书，浏览器会提示不安全）
https://{$PUBLIC_IP} {
	tls internal
	reverse_proxy 127.0.0.1:8000
}
