+    /// fork: stream resolution, frame rate and priority. Resolution defaults to native until
+    /// the client can follow a stream size that differs from the display; the rest default to auto.
+    fn fill_stream_options(&self, msg: &mut OptionMessage) {
+        use hbb_common::protobuf::Enum as _;
+        let get = |k: &str| self.get_option(k).parse::<i32>().unwrap_or(1);
+        msg.stream_resolution = self.get_option("stream-resolution").parse().unwrap_or(2);
+        msg.stream_fps = get("stream-fps");
+        self.apply_stream_fps_cap(msg.stream_fps);
+        msg.stream_priority = StreamPriority::from_i32(get("stream-priority"))
+            .unwrap_or(StreamPriority::StreamPriorityFps)
+            .into();
+    }
+
+    /// fork: the client-side frame pacing (io_loop) caps the stream at `custom_fps`, 30 by
+    /// default; follow the stream frame rate instead. "Follow display" (1) leaves the cap to the
+    /// controlled side, which knows the refresh rate.
+    fn apply_stream_fps_cap(&self, stream_fps: i32) {
+        let cap = if stream_fps > 1 { stream_fps as usize } else { 240 };
+        *self.custom_fps.lock().unwrap() = Some(cap);
+    }
+
+    /// fork: changes one stream option for this session and remembers it for the peer.
+    pub fn set_stream_option(&mut self, key: &str, value: i32) -> Message {
+        use hbb_common::protobuf::Enum as _;
+        let mut option = OptionMessage::default();
+        match key {
+            "stream-resolution" => option.stream_resolution = value,
+            "stream-fps" => {
+                option.stream_fps = value;
+                self.apply_stream_fps_cap(value);
+            }
+            "stream-priority" => {
+                option.stream_priority = StreamPriority::from_i32(value).unwrap_or_default().into()
+            }
+            _ => log::warn!("unknown stream option {key}"),
+        }
+        let mut config = self.load_config();
+        config.options.insert(key.to_owned(), value.to_string());
+        self.save_config(config);
+        let mut misc = Misc::new();
+        misc.set_option(option);
+        let mut msg_out = Message::new();
+        msg_out.set_misc(misc);
+        msg_out
+    }
