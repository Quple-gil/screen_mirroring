+// fork: stream resolution / frame rate / priority. The values match OptionMessage.stream_*:
+// 1 is auto, 2 is native, anything else is a fixed height or frame rate.
+const kStreamAuto = '1';
+const kStreamNative = '2';
+const kStreamPriorityFps = '1';
+const kStreamPriorityResolution = '2';
+const _kStreamHeights = [2160, 1440, 1080, 900, 720, 540];
+const _kStreamFps = [240, 165, 144, 120, 90, 60, 30, 15];
+
+Future<String> _streamOption(FFI ffi, String key, String defaultValue) async {
+  final v = await bind.sessionGetOption(sessionId: ffi.sessionId, arg: key);
+  return (v == null || v.isEmpty) ? defaultValue : v;
+}
+
+Future<void> _setStreamOption(FFI ffi, String key, String? value) async {
+  final v = int.tryParse(value ?? '');
+  if (v == null) return;
+  await bind.sessionSetStreamOption(sessionId: ffi.sessionId, key: key, value: v);
+}
+
+Future<List<TRadioMenu<String>>> toolbarStreamResolution(
+    BuildContext context, FFI ffi) async {
+  final groupValue =
+      await _streamOption(ffi, 'stream-resolution', kStreamNative);
+  onChanged(String? v) => _setStreamOption(ffi, 'stream-resolution', v);
+  final display = ffi.ffiModel.pi.tryGetDisplay();
+  final w = display?.width ?? 0;
+  final h = display?.height ?? 0;
+  TRadioMenu<String> radio(String label, String value) => TRadioMenu<String>(
+      child: Text(label),
+      value: value,
+      groupValue: groupValue,
+      onChanged: onChanged);
+  return [
+    radio(translate('Auto (follow network)'), kStreamAuto),
+    radio('${translate('Native')} ($w × $h)', kStreamNative),
+    if (w > 0 && h > 0)
+      for (final height in _kStreamHeights.where((x) => x < h))
+        radio('${(w * height / h).round() & ~1} × $height', '$height'),
+  ];
+}
+
+Future<List<TRadioMenu<String>>> toolbarStreamFps(
+    BuildContext context, FFI ffi) async {
+  final groupValue = await _streamOption(ffi, 'stream-fps', kStreamAuto);
+  onChanged(String? v) => _setStreamOption(ffi, 'stream-fps', v);
+  final refresh = ffi.ffiModel.pi.tryGetDisplay()?.refreshRate ?? 0;
+  final limit = refresh > 0 ? refresh : 60;
+  final choices = {
+    if (refresh > 0) refresh,
+    ..._kStreamFps.where((f) => f <= limit),
+  }.toList()
+    ..sort((a, b) => b.compareTo(a));
+  TRadioMenu<String> radio(String label, String value) => TRadioMenu<String>(
+      child: Text(label),
+      value: value,
+      groupValue: groupValue,
+      onChanged: onChanged);
+  return [
+    radio(
+        refresh > 0
+            ? '${translate('Follow display')} ($refresh Hz)'
+            : translate('Follow display'),
+        kStreamAuto),
+    for (final fps in choices) radio('$fps FPS', '$fps'),
+  ];
+}
+
+Future<List<TRadioMenu<String>>> toolbarStreamPriority(
+    BuildContext context, FFI ffi) async {
+  final groupValue =
+      await _streamOption(ffi, 'stream-priority', kStreamPriorityFps);
+  onChanged(String? v) => _setStreamOption(ffi, 'stream-priority', v);
+  return [
+    TRadioMenu<String>(
+        child: Text(translate('Prefer frame rate')),
+        value: kStreamPriorityFps,
+        groupValue: groupValue,
+        onChanged: onChanged),
+    TRadioMenu<String>(
+        child: Text(translate('Prefer resolution')),
+        value: kStreamPriorityResolution,
+        groupValue: groupValue,
+        onChanged: onChanged),
+  ];
+}
