diff --git a/src/server/local_mouse.rs b/src/server/local_mouse.rs
new file mode 100644
index 0000000..4afa6b6
--- /dev/null
+++ b/src/server/local_mouse.rs
@@ -0,0 +1,104 @@
+//! Local mouse priority (screen_mirroring fork).
+//!
+//! When the person at the controlled computer uses their own mouse, viewers' mouse input is
+//! ignored until that mouse has been still for a moment, so the two never fight over the one
+//! system cursor. Upstream's position-based check (`active_mouse_`) is disabled because it
+//! blocked and dropped fast moves; here a low-level mouse hook tells real input from injected
+//! (remote) input by `LLMHF_INJECTED`, and only records a timestamp, so nothing waits on it.
+
+use base::message_proto::MouseEvent;
+
+/// How long viewers' mouse input stays ignored after the local mouse last moved.
+#[cfg(windows)]
+const QUIET_MS: u64 = 800;
+
+/// Whether this viewer mouse event must be dropped because the local user is using the mouse.
+/// Button releases always pass, so a viewer's drag cut short never leaves a button held down.
+pub fn yield_to_local_user(evt: &MouseEvent) -> bool {
+    use crate::input::{MOUSE_TYPE_MASK, MOUSE_TYPE_UP};
+    evt.mask & MOUSE_TYPE_MASK != MOUSE_TYPE_UP && local_mouse_recently_used()
+}
+
+#[cfg(windows)]
+fn local_mouse_recently_used() -> bool {
+    imp::ensure_hook();
+    let last = imp::LAST_LOCAL_MS.load(std::sync::atomic::Ordering::Relaxed);
+    last != 0 && imp::now_ms().saturating_sub(last) < QUIET_MS
+}
+
+#[cfg(not(windows))]
+fn local_mouse_recently_used() -> bool {
+    false
+}
+
+#[cfg(windows)]
+mod imp {
+    use hbb_common::{lazy_static, log};
+    use std::{
+        io::Error,
+        sync::{
+            atomic::{AtomicU64, Ordering},
+            Once,
+        },
+        time::Instant,
+    };
+    use winapi::{
+        shared::minwindef::{HMODULE, LPARAM, LRESULT, WPARAM},
+        um::{libloaderapi::GetModuleHandleExA, winuser::*},
+    };
+
+    const GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT: u32 = 2;
+    const GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS: u32 = 4;
+
+    /// Milliseconds (+1, so 0 means "never") since `BASE` of the last real local mouse event.
+    pub static LAST_LOCAL_MS: AtomicU64 = AtomicU64::new(0);
+    static HOOK: Once = Once::new();
+
+    lazy_static::lazy_static! {
+        static ref BASE: Instant = Instant::now();
+    }
+
+    pub fn now_ms() -> u64 {
+        BASE.elapsed().as_millis() as u64 + 1
+    }
+
+    unsafe extern "system" fn hook_mouse(code: i32, w_param: WPARAM, l_param: LPARAM) -> LRESULT {
+        if code >= 0 {
+            let info = &*(l_param as *const MSLLHOOKSTRUCT);
+            if info.flags & LLMHF_INJECTED == 0 {
+                LAST_LOCAL_MS.store(now_ms(), Ordering::Relaxed);
+            }
+        }
+        CallNextHookEx(std::ptr::null_mut(), code, w_param, l_param)
+    }
+
+    /// Starts the hook thread once, in whichever process injects the viewers' input (the server,
+    /// or the portable service when that is running).
+    pub fn ensure_hook() {
+        HOOK.call_once(|| {
+            let _ = now_ms();
+            std::thread::spawn(|| unsafe {
+                let mut module: HMODULE = std::ptr::null_mut();
+                if GetModuleHandleExA(
+                    GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                    hook_mouse as _,
+                    &mut module,
+                ) == 0
+                {
+                    log::warn!("local mouse priority off: GetModuleHandleExA, {}", Error::last_os_error());
+                    return;
+                }
+                let hook = SetWindowsHookExA(WH_MOUSE_LL, Some(hook_mouse), module, 0);
+                if hook.is_null() {
+                    log::warn!("local mouse priority off: SetWindowsHookExA, {}", Error::last_os_error());
+                    return;
+                }
+                log::info!("local mouse priority on");
+                // Low-level hooks are called on this thread's message loop.
+                let mut msg: MSG = std::mem::zeroed();
+                while GetMessageA(&mut msg, std::ptr::null_mut(), 0, 0) > 0 {}
+                UnhookWindowsHookEx(hook);
+            });
+        });
+    }
+}
diff --git a/src/server/stream_scale.rs b/src/server/stream_scale.rs
new file mode 100644
index 0000000..d53c764
--- /dev/null
+++ b/src/server/stream_scale.rs
@@ -0,0 +1,400 @@
+//! Stream resolution (screen_mirroring fork).
+//!
+//! A viewer can pick a fixed stream height or "auto". Auto steps the encoded resolution down
+//! when the network is congested and back up when it recovers; the viewer's priority decides
+//! whether the frame rate or the resolution is given up first. Only the encoder input is
+//! scaled, so the shared screen's display mode never changes under the person using it.
+
+use super::video_qos::{VideoQoS, MAX_FPS, MIN_FPS};
+use base::message_proto::{Message, MouseEvent};
+use hbb_common::{bail, log, ResultType};
+use scrap::{codec::EncoderCfg, Frame, PixelBuffer, Pixfmt, TraitPixelBuffer};
+use std::{
+    borrow::Cow,
+    collections::HashMap,
+    sync::Mutex,
+    time::{Duration, Instant},
+};
+
+/// `OptionMessage.stream_resolution` values besides a fixed height.
+pub const AUTO: i32 = 1;
+pub const NATIVE: i32 = 2;
+const LADDER: [usize; 6] = [2160, 1440, 1080, 900, 720, 540];
+const STEP_COOLDOWN: Duration = Duration::from_secs(10);
+// Delay replies arrive about once a second.
+const DOWN_SAMPLES: u32 = 3;
+const UP_SAMPLES: u32 = 10;
+const MIN_FPS_FOR_RESOLUTION_PRIORITY: u32 = 10;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub enum Priority {
+    #[default]
+    Fps,
+    Resolution,
+}
+
+#[derive(Debug, Default, Clone)]
+pub struct UserStream {
+    /// 0 (not set, native), `AUTO`, `NATIVE`, or a fixed stream height.
+    resolution: i32,
+    priority: Priority,
+    /// Auto mode: 0 is native, n is the n-th step down the ladder.
+    level: usize,
+    bad: u32,
+    good: u32,
+    changed_at: Option<Instant>,
+}
+
+impl UserStream {
+    pub fn set_resolution(&mut self, resolution: i32) {
+        if resolution != self.resolution {
+            *self = Self {
+                resolution,
+                priority: self.priority,
+                ..Default::default()
+            };
+        }
+    }
+
+    pub fn set_priority(&mut self, priority: i32) {
+        use base::message_proto::StreamPriority;
+        use hbb_common::protobuf::Enum as _;
+        if priority == StreamPriority::StreamPriorityResolution.value() {
+            self.priority = Priority::Resolution;
+        } else if priority == StreamPriority::StreamPriorityFps.value() {
+            self.priority = Priority::Fps;
+        }
+    }
+
+    /// Feeds one network-delay reply; `fps` is what the delay controller just picked for this
+    /// viewer and `cap` the frame rate the viewer asked for.
+    pub fn on_delay(&mut self, avg_delay: u32, fps: u32, cap: u32, now: Instant) {
+        if self.resolution != AUTO {
+            return;
+        }
+        let congested = match self.priority {
+            // Lower the resolution before the frame rate falls under 60% of what was asked.
+            Priority::Fps => fps * 10 < cap * 6,
+            // Hold the resolution until even a low frame rate cannot be kept.
+            Priority::Resolution => fps < MIN_FPS_FOR_RESOLUTION_PRIORITY.min(cap),
+        };
+        let healthy = avg_delay < 50 && fps >= cap;
+        if congested {
+            self.bad += 1;
+            self.good = 0;
+        } else if healthy {
+            self.good += 1;
+            self.bad = 0;
+        } else {
+            self.bad = 0;
+            self.good = 0;
+        }
+        if self
+            .changed_at
+            .map(|t| now.saturating_duration_since(t) < STEP_COOLDOWN)
+            .unwrap_or(false)
+        {
+            return;
+        }
+        let new_level = if self.bad >= DOWN_SAMPLES && self.level < LADDER.len() {
+            self.level + 1
+        } else if self.good >= UP_SAMPLES && self.level > 0 {
+            self.level - 1
+        } else {
+            return;
+        };
+        log::info!(
+            "stream resolution level {} -> {new_level} (avg_delay={avg_delay}, fps={fps}/{cap}, {:?})",
+            self.level,
+            self.priority
+        );
+        self.level = new_level;
+        self.bad = 0;
+        self.good = 0;
+        self.changed_at = Some(now);
+    }
+
+    /// Stream height wanted for a display of native height `native_h`; `None` keeps native.
+    fn height(&self, native_h: usize) -> Option<usize> {
+        let height = match self.resolution {
+            0 | NATIVE => return None,
+            AUTO => {
+                if self.level == 0 {
+                    return None;
+                }
+                let ladder: Vec<usize> = LADDER.iter().copied().filter(|&h| h < native_h).collect();
+                *ladder.get(self.level - 1).or(ladder.last())?
+            }
+            h if h > 0 => h as usize,
+            _ => return None,
+        };
+        (height < native_h).then_some(height)
+    }
+}
+
+/// Frame rate cap for `OptionMessage.stream_fps`; `AUTO` follows the fastest display.
+pub fn stream_fps(value: i32) -> Option<u32> {
+    let fps = match value {
+        v if v <= 0 => return None,
+        AUTO => max_refresh_rate().unwrap_or(60),
+        v => v as u32,
+    };
+    Some(fps.clamp(MIN_FPS, MAX_FPS))
+}
+
+fn max_refresh_rate() -> Option<u32> {
+    #[cfg(windows)]
+    {
+        let displays = super::display_service::try_get_displays().ok()?;
+        displays
+            .iter()
+            .map(|d| crate::platform::windows::current_refresh_rate(&d.name()))
+            .max()
+            .filter(|&r| r > 0)
+    }
+    #[cfg(not(windows))]
+    None
+}
+
+/// The smallest stream height any viewer needs, since all viewers share one encoder.
+pub fn target_height<'a>(users: impl Iterator<Item = &'a UserStream>, native_h: usize) -> Option<usize> {
+    users.filter_map(|u| u.height(native_h)).min()
+}
+
+/// Encoded size for a display of `native` size, or `None` to encode at native size.
+pub fn target_size(qos: &VideoQoS, native: (usize, usize)) -> Option<(usize, usize)> {
+    let (w, h) = native;
+    let target_h = qos.stream_height(h)?;
+    // Even sizes keep every encoder and the 4:2:0 conversion happy.
+    let scaled_w = ((w * target_h + h / 2) / h) & !1;
+    Some((scaled_w.max(2), (target_h & !1).max(2)))
+}
+
+/// Points the encoder config at the scaled size. VRAM encoders take the capture texture as-is,
+/// so a scaled stream uses the CPU-side hardware encoder (or VP9) instead.
+pub fn rescale_config(cfg: EncoderCfg, (width, height): (usize, usize)) -> EncoderCfg {
+    match cfg {
+        #[cfg(feature = "vram")]
+        EncoderCfg::VRAM(vram) => {
+            #[cfg(feature = "hwcodec")]
+            if let Some(hw) = scrap::hwcodec::HwRamEncoder::try_get(scrap::codec::Encoder::negotiated_codec()) {
+                return EncoderCfg::HWRAM(scrap::hwcodec::HwRamEncoderConfig {
+                    name: hw.name,
+                    mc_name: hw.mc_name,
+                    width,
+                    height,
+                    quality: vram.quality,
+                    keyframe_interval: vram.keyframe_interval,
+                });
+            }
+            EncoderCfg::VPX(scrap::vpxcodec::VpxEncoderConfig {
+                width: width as _,
+                height: height as _,
+                quality: vram.quality,
+                codec: scrap::vpxcodec::VpxVideoCodecId::VP9,
+                keyframe_interval: vram.keyframe_interval,
+            })
+        }
+        #[cfg(feature = "hwcodec")]
+        EncoderCfg::HWRAM(mut c) => {
+            c.width = width;
+            c.height = height;
+            EncoderCfg::HWRAM(c)
+        }
+        EncoderCfg::VPX(mut c) => {
+            c.width = width as _;
+            c.height = height as _;
+            EncoderCfg::VPX(c)
+        }
+        EncoderCfg::AOM(mut c) => {
+            c.width = width as _;
+            c.height = height as _;
+            EncoderCfg::AOM(c)
+        }
+        #[allow(unreachable_patterns)]
+        other => other,
+    }
+}
+
+/// Scales a captured frame down to the stream size before color conversion.
+pub fn scale_frame<'a>(
+    frame: Frame<'a>,
+    target: Option<(usize, usize)>,
+    buf: &'a mut Vec<u8>,
+) -> ResultType<Frame<'a>> {
+    let Some((width, height)) = target else {
+        return Ok(frame);
+    };
+    match frame {
+        Frame::PixelBuffer(captured) => {
+            if (captured.width(), captured.height()) == (width, height) {
+                return Ok(Frame::PixelBuffer(captured));
+            }
+            let pixfmt: Pixfmt = captured.pixfmt();
+            scrap::scale_32bit(&captured, width, height, buf)?;
+            let scaled: &'a Vec<u8> = buf;
+            Ok(Frame::PixelBuffer(PixelBuffer::new(scaled, pixfmt, width, height)))
+        }
+        Frame::Texture(_) => bail!("texture frames cannot be scaled"),
+    }
+}
+
+// Viewers size their decoder, texture and mouse mapping from the display size they were told,
+// and drop or misplace frames of any other size. So while a display's stream is scaled they are
+// told the stream size, and mouse / cursor positions are translated between the two sizes.
+
+#[derive(Clone, Copy, Debug)]
+struct Scaled {
+    origin: (i32, i32),
+    native: (usize, usize),
+    stream: (usize, usize),
+}
+
+lazy_static::lazy_static! {
+    // Keyed by video service name, so a camera never picks up a monitor's entry.
+    static ref SCALED: Mutex<HashMap<String, (usize, Scaled)>> = Default::default();
+}
+
+/// Records the size the monitor service `name` now encodes `display_idx` at. Returns the
+/// display-changed message for its current viewers when that differs from what they were told.
+pub fn update_display(
+    name: &str,
+    display_idx: usize,
+    origin: (i32, i32),
+    native: (usize, usize),
+    stream: Option<(usize, usize)>,
+) -> Option<Message> {
+    let mut scaled = SCALED.lock().unwrap();
+    let before = scaled.get(name).map(|(_, s)| s.stream).unwrap_or(native);
+    match stream {
+        Some(stream) => scaled.insert(name.to_owned(), (display_idx, Scaled { origin, native, stream })),
+        None => scaled.remove(name),
+    };
+    drop(scaled);
+    let shown = stream.unwrap_or(native);
+    if before == shown {
+        return None;
+    }
+    log::info!("display {display_idx} is shown to viewers as {}x{}", shown.0, shown.1);
+    display_changed_msg(display_idx, shown)
+}
+
+/// What a viewer joining the service `name` must be told before its first frame of a scaled stream.
+pub fn scaled_display_msg(name: &str) -> Option<Message> {
+    let (display_idx, scaled) = *SCALED.lock().unwrap().get(name)?;
+    display_changed_msg(display_idx, scaled.stream)
+}
+
+fn display_changed_msg(display_idx: usize, (width, height): (usize, usize)) -> Option<Message> {
+    let mut display = super::display_service::get_display_info(display_idx)?;
+    display.width = width as _;
+    display.height = height as _;
+    super::video_service::make_display_changed_msg(
+        display_idx,
+        Some(display),
+        super::video_service::VideoSource::Monitor,
+    )
+}
+
+/// A viewer's mouse event, moved from the scaled display it was shown back onto the desktop.
+pub fn to_native_event(evt: &MouseEvent) -> Cow<'_, MouseEvent> {
+    use crate::input::{MOUSE_TYPE_MASK, MOUSE_TYPE_MOVE_RELATIVE};
+    if evt.mask & MOUSE_TYPE_MASK == MOUSE_TYPE_MOVE_RELATIVE {
+        return Cow::Borrowed(evt);
+    }
+    match map_point(evt.x, evt.y, |s| (s.stream, s.native)) {
+        Some((x, y)) => {
+            let mut evt = evt.clone();
+            evt.x = x;
+            evt.y = y;
+            Cow::Owned(evt)
+        }
+        None => Cow::Borrowed(evt),
+    }
+}
+
+/// A desktop cursor position, moved into the scaled display the viewers see.
+pub fn to_stream_pos(x: i32, y: i32) -> (i32, i32) {
+    map_point(x, y, |s| (s.native, s.stream)).unwrap_or((x, y))
+}
+
+fn map_point(
+    x: i32,
+    y: i32,
+    sizes: impl Fn(&Scaled) -> ((usize, usize), (usize, usize)),
+) -> Option<(i32, i32)> {
+    let scaled = SCALED.lock().unwrap();
+    scaled.values().find_map(|(_, s)| {
+        let ((from_w, from_h), (to_w, to_h)) = sizes(s);
+        let (dx, dy) = ((x - s.origin.0) as i64, (y - s.origin.1) as i64);
+        if dx < 0 || dy < 0 || dx >= from_w as i64 || dy >= from_h as i64 {
+            return None;
+        }
+        Some((
+            s.origin.0 + (dx * to_w as i64 / from_w as i64) as i32,
+            s.origin.1 + (dy * to_h as i64 / from_h as i64) as i32,
+        ))
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn auto(priority: Priority) -> UserStream {
+        let mut s = UserStream::default();
+        s.set_resolution(AUTO);
+        s.priority = priority;
+        s
+    }
+
+    fn feed(s: &mut UserStream, n: u32, avg_delay: u32, fps: u32, now: Instant) {
+        for _ in 0..n {
+            s.on_delay(avg_delay, fps, 60, now);
+        }
+    }
+
+    #[test]
+    fn fps_priority_lowers_resolution_with_cooldown() {
+        let t0 = Instant::now();
+        let mut s = auto(Priority::Fps);
+        feed(&mut s, 3, 300, 20, t0);
+        assert_eq!(s.height(2160), Some(1440));
+        feed(&mut s, 5, 300, 20, t0 + Duration::from_secs(5));
+        assert_eq!(s.height(2160), Some(1440), "no second step inside the cooldown");
+        feed(&mut s, 3, 300, 20, t0 + Duration::from_secs(11));
+        assert_eq!(s.height(2160), Some(1080));
+    }
+
+    #[test]
+    fn resolution_priority_keeps_resolution_until_fps_collapses() {
+        let t0 = Instant::now();
+        let mut s = auto(Priority::Resolution);
+        feed(&mut s, 5, 300, 20, t0);
+        assert_eq!(s.height(2160), None);
+        feed(&mut s, 3, 600, 8, t0);
+        assert_eq!(s.height(2160), Some(1440));
+    }
+
+    #[test]
+    fn healthy_network_restores_native() {
+        let t0 = Instant::now();
+        let mut s = auto(Priority::Fps);
+        feed(&mut s, 3, 300, 20, t0);
+        feed(&mut s, 10, 20, 60, t0 + Duration::from_secs(11));
+        assert_eq!(s.height(2160), None);
+    }
+
+    #[test]
+    fn shared_stream_uses_smallest_height_and_keeps_aspect() {
+        let mut qos = VideoQoS::default();
+        qos.on_connection_open(1);
+        qos.on_connection_open(2);
+        qos.user_stream_resolution(1, 1080);
+        qos.user_stream_resolution(2, 720);
+        assert_eq!(target_size(&qos, (3440, 1440)), Some((1720, 720)));
+        qos.user_stream_resolution(2, NATIVE);
+        assert_eq!(target_size(&qos, (2560, 1440)), Some((1920, 1080)));
+        assert_eq!(target_size(&qos, (1920, 1080)), None, "fixed height not below native");
+    }
+}
